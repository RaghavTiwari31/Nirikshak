# Copy to .env.offline and replace every value. Generate secrets with:
#   openssl rand -hex 32
# (or in PowerShell: -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) }))
SATSA_VERSION=0.1.0
WEB_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

POSTGRES_PASSWORD=replace-with-a-long-random-value
# Both must be at least 32 characters and different from each other.
JWT_SECRET=replace-with-64-hex-characters
PSEUDONYM_HMAC_KEY=replace-with-a-different-64-hex-value

# Used only by the optional `seed` (demo) service.
ADMIN_PASSWORD=replace-with-an-admin-password
SEED_ENTITIES=40
SEED_MONTHS=12
