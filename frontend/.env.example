# Leave empty in local dev (Vite proxies /api to localhost:8000).
# On Vercel set it to the Render API origin, e.g. https://satsa-api.onrender.com
VITE_API_BASE_URL=

# Optional demo account, shown on the login page with a one-click sign-in. Only for the
# hackathon demo on synthetic data: the values are built into the public JavaScript, so
# never set them in a real deployment. Create the user first:
#   python -m app.cli create-user --username demo --display-name "Demo Admin" --role admin
# Quote the password if it contains '#', which otherwise starts a comment.
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=
